<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.lc4j.mapper.ChatSessionMapper">

    <!-- 鏌ヨ鏈垹闄ょ殑浼氳瘽锛堟寜鏇存柊鏃堕棿鍊掑簭锛?-->
    <select id="selectActive" resultType="com.example.lc4j.entity.ChatSession">
        SELECT * FROM chat_session
        WHERE is_deleted = 0
        ORDER BY update_time DESC
    </select>

    <!-- 缁熻浼氳瘽鏁伴噺 -->
    <select id="count" resultType="int">
        SELECT COUNT(*) FROM chat_session WHERE is_deleted = 0
    </select>

</mapper>
