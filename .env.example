# ============================================
# 格物 Gewu — 环境配置模板
# 用法: cp .env.example .env，然后修改其中的值
# ============================================

# ---------- 数据库 ----------
GEWU_DB_NAME=gewu
GEWU_DB_USER=gewu
# 生产必须改强密码（openssl rand -base64 24）
GEWU_DB_PASSWORD=changeme-db-password
# 宿主机暴露端口（不需要外部直连 DB 时可注释 compose 的 ports）
GEWU_DB_PORT=15432

# ---------- JWT ----------
# 生产必须改随机值（openssl rand -base64 48）；改后所有已登录 token 失效
GEWU_JWT_SECRET=changeme-generate-random-48-bytes

# ---------- 模型密钥加密（T3，生产必须配置） ----------
# openssl rand -base64 48 生成；未配置时回退开发密钥（密文等同明文，严禁生产裸奔）
GEWU_ENCRYPT_KEY=

# ---------- 模型 API Key ----------
# 方式一（推荐）：启动后在网页「设置 → 模型配置」里写入（AES-256-GCM 密文落库，保存即生效）
# 方式二：通过 env 注入，供 application.yml 内置 seed 启动（首次启动自动导入 DB）
VOLC_API_KEY=

# ---------- 用量配额（T6，默认关闭） ----------
GEWU_QUOTA_ENABLED=false
GEWU_QUOTA_DAILY_TOKEN_LIMIT=200000

# ---------- 端口 ----------
# 后端 API（宿主机访问端口；容器内固定 8081，nginx 反代目标）
GEWU_SERVER_PORT=8080

# ---------- JVM ----------
GEWU_JAVA_OPTS=-Xms512m -Xmx1024m

# ---------- 镜像名（离线部署 docker save/load 时用） ----------
GEWU_SERVER_IMAGE=gewu/gewu-server:latest
